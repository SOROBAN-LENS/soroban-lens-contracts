# SorobanLens contracts: example environment for scripts/deploy-testnet.sh.
# Copy to `.env` and adjust. `.env` is git-ignored.
#
# This file contains NO secrets. Signing keys live in the Stellar CLI keystore
# (`stellar keys generate ...`), referenced here only by identity *name*.

# Network name as known to the Stellar CLI (`stellar network ls`).
STELLAR_NETWORK=testnet

# Public testnet endpoints (no API key required).
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Name of a Stellar CLI identity used as deployer and contract admin.
# Create and fund it with:  stellar keys generate sorobanlens-admin --network testnet --fund
STELLAR_ADMIN_IDENTITY=sorobanlens-admin

# A second identity used to reproduce "wrong signer" scenarios.
STELLAR_OTHER_IDENTITY=sorobanlens-other
